{
  "name": "pi-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A DOM-first Chrome companion for Pi, with Jev choosing tabs and links",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.integration.js",
    "test:live": "PI_BROWSER_LIVE=1 node --test test/live.integration.js",
    "test:pi": "node --test test/pi.integration.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typebox": "^1.3.34"
  }
}
